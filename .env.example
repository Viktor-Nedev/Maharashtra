# ----------------------------------------------------------------------------
# Maharashtra — environment variables
# Copy this file to `.env` (local) and/or set these in the Vercel dashboard.
#
# The app runs WITHOUT any keys (seed data + localStorage + a static hero),
# so you can demo with zero config. For the full live experience set them all.
# ----------------------------------------------------------------------------

# === BUILD-TIME (VITE_*) — needed at `npm run build`; safe to expose ==========

# Mapbox — the 3D satellite flight on the homepage. Without it the home shows a
# static scenic hero instead. REQUIRED for the cinematic flight.
VITE_MAPBOX_TOKEN=

# Supabase — user auth, saved trips, planned trips, booking history.
# Without these, auth/persistence are disabled (local-only demo mode).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe — publishable key for the booking payment form (safe in the browser).
VITE_STRIPE_PK=

# === SERVER-SIDE RUNTIME — set in the Vercel dashboard, NOT VITE_ prefixed ====
# Do NOT put these in a committed .env; they must never reach the browser.

# Stripe secret key — used by /api/create-payment-intent
# STRIPE_SECRET_KEY=sk_test_...

# Google Gemini — used by /api/gemini-advise (the AI trip advisor)
# GEMINI_API_KEY=...

# (Legacy) Anthropic — only if you re-enable /api/advise
# ANTHROPIC_API_KEY=sk-ant-...
