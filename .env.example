# ----------------------------------------------------------------------------
# Maharashtra — environment variables
# Copy this file to `.env` and fill in your own keys.
# The app runs fully WITHOUT these (mock data + graceful fallbacks),
# so you can demo the cinematic experience with zero config.
# ----------------------------------------------------------------------------

# Mapbox (3D satellite flight map on homepage)
VITE_MAPBOX_TOKEN=

# Supabase (user auth, booking persistence, saved trips)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (payment processing on the booking page)
# Publishable key goes here (safe to expose to browser)
VITE_STRIPE_PK=

# These are SERVER-SIDE ONLY — set in Vercel dashboard, NOT here
# STRIPE_SECRET_KEY=sk_test_...
# ANTHROPIC_API_KEY=sk-ant-...
