# ----------------------------------------------------------------------------
# Maharashtra — environment variables
# Copy this file to `.env` and fill in your own keys.
# The app runs fully WITHOUT these (mock data + graceful fallbacks),
# so you can demo the cinematic experience with zero config.
# ----------------------------------------------------------------------------

# Supabase (booking platform, accounts, reviews)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox (world map / destination geography)
VITE_MAPBOX_TOKEN=
